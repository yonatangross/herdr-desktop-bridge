# herdr-floor bridge settings. The MCP client passes these to the server it
# launches (the "env" block of its server entry). No secrets are needed: the
# bridge talks only to the local herdr or hc binary.

# herdr (the herdr CLI) or hc (the herdr-core client)
HERDR_BRIDGE_BACKEND=herdr

# Absolute path to the backend binary, when it is not on the client's PATH
HERDR_BRIDGE_BIN=

# Comma separated fnmatch globs of names floor_prompt may reach.
# Empty refuses every prompt (the safe default). Example: conductor,*-desk
HERDR_BRIDGE_PROMPT_ALLOW=

# Where floor_inbox writes its notes. Default: ~/.herdr-bridge/inbox
HERDR_BRIDGE_INBOX_DIR=

# Sender label in inbox notes. Default: the name the client sends on initialize
HERDR_BRIDGE_CLIENT_NAME=

# Privacy gate (scripts/scrub.sh), maintainers only. Point both at files
# OUTSIDE this repo.
SCRUB_PRIVATE_PATTERNS=
SCRUB_CLIENTS_DIR=
